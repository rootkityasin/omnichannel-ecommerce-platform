{
  "name": "omnichannel-ecommerce-platform",
  "version": "1.0.68",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rootkityasin/omnichannel-ecommerce-platform.git"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "dev:turbo": "next dev --turbo",
    "build": "prisma generate && prisma generate --schema prisma/platform/schema.prisma && set NEXT_DISABLE_TURBOPACK=1&& node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build --webpack",
    "build:docker": "prisma generate && prisma generate --schema prisma/platform/schema.prisma && node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "profile:vps": "bash scripts/profile-vps-hotspots.sh",
    "profile:compare": "node scripts/compare-perf-summaries.js",
    "postinstall": "prisma generate && prisma generate --schema prisma/platform/schema.prisma",
    "benchmark": "node scripts/benchmark.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/react-datepicker": "^6.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "autocannon": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "botid": "^1.5.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.26",
    "k6": "^0.0.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^6.0.3",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ua-parser-js": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prisma": "^7.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
