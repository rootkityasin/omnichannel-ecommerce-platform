generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  customDomain   String?         @unique
  plan           String          @default("FREE")
  setupFee       Int             @default(6000)
  setupFeePaid   Boolean         @default(false)
  isActive       Boolean         @default(true)
  enabledModules String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]
  categories     Category[]
  coupons        Coupon[]
  deliveryConfig DeliveryConfig?
  hubs           Hub[]
  orders         Order[]
  paymentConfig  PaymentConfig?
  products       Product[]
  promos         PromoCard[]
  siteConfig     SiteConfig?
  users          User[]
}

model Product {
  id              String           @id @default(cuid())
  tenantId        String?
  name            String
  price           Int
  image           String?
  isAvailable     Boolean          @default(true)
  categoryId      String
  cookingImage    String?
  nutritionImage  String?
  description     String?
  description_bar String?
  description_bn  String?
  description_ctg String?
  description_noa String?
  name_bar        String?
  name_bn         String?
  name_ctg        String?
  name_noa        String?
  pieces          Int              @default(0)
  pointsReward    Int              @default(0)
  weight          Int              @default(0)
  servingSize     Int              @default(1)
  sku             String           @unique
  stage           String           @default("Draft")
  type            ProductType      @default(SINGLE)
  images          String[]
  totalSold       Int              @default(0)
  createdAt       DateTime         @default(now())
  descriptionSwap Boolean          @default(false)
  partOfCombos    ComboItem[]      @relation("ComboChild")
  comboItems      ComboItem[]      @relation("ComboParent")
  inventory       Inventory[]
  modifiers       Modifier[]
  orderItems      OrderItem[]
  category        Category         @relation(fields: [categoryId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  reviews         Review[]
  sections        ProductSection[] @relation("ProductToProductSection")

  @@index([tenantId])
  @@index([categoryId])
  @@index([isAvailable])
}

model ComboItem {
  id       String  @id @default(cuid())
  parentId String
  childId  String
  quantity Int
  child    Product @relation("ComboChild", fields: [childId], references: [id])
  parent   Product @relation("ComboParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model Modifier {
  id        String   @id @default(cuid())
  name      String
  options   String[]
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model OrderItem {
  id                String  @id @default(cuid())
  quantity          Int
  price             Int
  productId         String
  orderId           String
  selectedModifiers String?
  order             Order   @relation(fields: [orderId], references: [id])
  product           Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Category {
  id            String    @id @default(cuid())
  tenantId      String?
  name          String
  animationType String    @default("AUTO")
  icon          String    @default("Package")
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  products      Product[]

  @@index([tenantId])
}

model PromoCard {
  id            String   @id @default(cuid())
  tenantId      String?
  title         String
  description   String?
  imageUrl      String
  style         String   @default("CLASSIC")
  buttonText    String?
  buttonLink    String?
  price         String?
  originalPrice String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
}

model SiteConfig {
  id                     String    @id @default(cuid())
  tenantId               String?   @unique
  contactPhone           String    @default("+880 0000 000 000")
  contactEmail           String    @default("support@example.com")
  contactAddress         String    @default("City, Country")
  shopName               String    @default("Omnichannel Shop")
  logoUrl                String?
  measurementUnit        String    @default("PCS")
  allergensText          String    @default("None")
  certificates           Json      @default("[]")
  adminSetupToken        String    @default("setup-token-123")
  primaryColor           String    @default("#000000")
  secondaryColor         String    @default("#0f172a")
  taxPercentage          Float     @default(0.0)
  shopType               ShopType  @default(RESTAURANT)
  weightUnitValue        Int       @default(200)
  volumeUnitValue        Int       @default(1000)
  privacyPolicy          String?   @default("We value your privacy. Your data is safe with us.")
  refundPolicy           String?   @default("Refunds are processed within 5-7 business days.")
  termsPolicy            String?   @default("By using our service, you agree to our terms of service.")
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String?
  ogTitle                String?
  ogDescription          String?
  ogImage                String?
  twitterCard            String?   @default("summary_large_image")
  twitterTitle           String?
  twitterDescription     String?
  twitterImage           String?
  jsonLdType             String?   @default("Restaurant")
  robots                 String?   @default("index, follow")
  canonicalUrl           String?
  sitelinks              Json      @default("[]")
  metaPixelId            String?
  metaAccessToken        String?
  socialFacebook         String?
  socialInstagram        String?
  socialTwitter          String?
  socialLinkedIn         String?
  socialYoutube          String?
  invoiceTheme           String    @default("modern")
  invoiceDetails         Json      @default("{\"fontSize\": 14, \"showBuyer\": true, \"showSeller\": true, \"showSignature\": true, \"watermarkOpacity\": 0.1}")
  labsmailBaseUrl        String?
  labsmailLeadKey        String?
  labsmailActive         Boolean   @default(false)
  labsmailLastExportedAt DateTime?
  primaryHub             String?   @default("dhaka-central")
  tenant                 Tenant?   @relation(fields: [tenantId], references: [id])
}

model Hub {
  id        String      @id @default(cuid())
  tenantId  String?
  name      String
  location  String
  expenses  Expense[]
  freezers  Freezer[]
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  inventory Inventory[]
  orders    Order[]
  users     User[]

  @@index([tenantId])
}

model User {
  id          String    @id @default(cuid())
  tenantId    String?
  name        String
  email       String    @unique
  phone       String?   @unique
  role        Role      @default(USER)
  permissions String[]  @default([])
  isBlocked   Boolean   @default(false)
  hubId       String?
  image       String?
  password    String?
  address     String?
  points      Int       @default(0)
  status      String    @default("Bronze")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  accounts    Account[]
  reviews     Review[]
  sessions    Session[]
  hub         Hub?      @relation(fields: [hubId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Inventory {
  id        String   @id @default(cuid())
  hubId     String
  productId String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  freezerId String?
  freezer   Freezer? @relation(fields: [freezerId], references: [id])
  hub       Hub      @relation(fields: [hubId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([hubId])
  @@index([productId])
}

model Freezer {
  id          String      @id @default(cuid())
  name        String
  temperature Float
  capacity    Int
  hubId       String
  hub         Hub         @relation(fields: [hubId], references: [id])
  inventory   Inventory[]
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String
  date        DateTime @default(now())
  hubId       String?
  description String?
  createdAt   DateTime @default(now())
  hub         Hub?     @relation(fields: [hubId], references: [id])
}

model Coupon {
  id             String       @id @default(cuid())
  tenantId       String?
  code           String       @unique
  discountType   DiscountType @default(FIXED)
  discountValue  Int
  minOrderAmount Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  usageLimit     Int?
  usedCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant?      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([code])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String?
  orderId         String      @unique
  status          String      @default("PENDING")
  customerName    String
  customerPhone   String
  customerAddress String
  source          String      @default("WEB")
  totalAmount     Int
  createdAt       DateTime    @default(now())
  hubId           String?
  couponCode      String?
  discountAmount  Int?
  stockDeducted   Boolean     @default(false)
  customerEmail       String?
  paymentMethod       String?      @default("COD")
  advancePaidAmount   Int          @default(0)
  advancePaymentStatus String      @default("NOT_REQUIRED")
  transactionId       String?
  hub                 Hub?        @relation(fields: [hubId], references: [id])
  tenant              Tenant?     @relation(fields: [tenantId], references: [id])
  items               OrderItem[]

  @@index([tenantId])
  @@index([hubId])
  @@index([status])
  @@index([customerPhone])
}

model PaymentConfig {
  id                  String   @id @default(cuid())
  tenantId            String?  @unique
  isActive            Boolean  @default(true)
  codEnabled          Boolean  @default(true)
  bkashEnabled        Boolean  @default(false)
  bkashLogo           String?
  bkashAppKey         String?
  bkashSecretKey      String?
  bkashUsername       String?
  bkashPassword       String?
  nagadEnabled        Boolean  @default(false)
  nagadLogo           String?
  nagadMerchantNumber String?
  nagadPublicKey      String?
  nagadPrivateKey     String?
  selfMfsEnabled      Boolean  @default(false)
  selfMfsType         String?
  selfMfsPhone        String?
  selfMfsInstruction  String?
  selfMfsQrCode       String?
  advancePaymentEnabled Boolean  @default(false)
  advancePaymentType  String?
  advancePaymentValue Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant?  @relation(fields: [tenantId], references: [id])
}

model SecurityLog {
  id        String   @id @default(cuid())
  ipAddress String
  action    String
  severity  String
  details   String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorName  String
  actorEmail String
  action     String
  entity     String
  entityId   String?
  details    String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  deviceId   String   @unique
  name       String
  userAgent  String?
  lastUsed   DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  browser    String?
  deviceType String?
  ipAddress  String?
  location   String?
  os         String?
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HeroSlide {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String
  title_bn    String?
  subtitle    String?
  subtitle_bn String?
  buttonText  String?
  buttonLink  String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StorySection {
  id        String   @id @default(cuid())
  type      String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  images    String[]
  userId    String
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product? @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ProductSection {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[] @relation("ProductToProductSection")
}

model DeliveryConfig {
  id                       String   @id @default(cuid())
  tenantId                 String?  @unique
  defaultCharge            Int      @default(60)
  defaultCodEnabled        Boolean  @default(true)
  nonRefundable            Boolean  @default(false)
  weightBasedCharges       Json     @default("[]")
  deliveryZones            Json     @default("[]")
  courierPathaoEnabled     Boolean  @default(false)
  courierPathaoCredentials Json?
  pointsReward             Float    @default(0)
  freeDeliveryOver         Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenant                   Tenant?  @relation(fields: [tenantId], references: [id])
}

model TrackingEvent {
  id            String   @id @default(cuid())
  eventName     String
  customerName  String?
  customerPhone String?
  customerEmail String?
  customerArea  String?
  customerCity  String?
  ipAddress     String?
  userAgent     String?
  sourceUrl     String?
  eventData     Json?
  rawPayload    Json?
  createdAt     DateTime @default(now())
}

model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String
  price         Float
  originalPrice Float?
  period        String   @default("/month")
  features      Json     @default("[]")
  color         String   @default("bg-slate-500")
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ProductType {
  SINGLE
  COMBO
}

enum ShopType {
  RESTAURANT
  GROCERY
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  HUB_ADMIN
  STAFF
  USER
}
